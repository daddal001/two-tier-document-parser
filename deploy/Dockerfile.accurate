# MinerU 4 GPU runtime. The base image supplies the vLLM/CUDA stack; CPU-only deployments use
# Dockerfile.accurate.cpu. MinerU 4.2.3 declares vLLM >=0.19.1,<0.31.0, and this image runs
# v0.34.0 (the newest, with no published advisories), which MinerU has not declared support for:
# the installs below use --no-deps, so nothing enforces that range. The T4 notebook
# (examples/notebooks/accurate_t4_check.ipynb) is the check that it works.
FROM vllm/vllm-openai:v0.34.0
# vLLM publishes no CUDA 12.9 image for v0.34.0 (the last tag with one is v0.32.0-cu129, which
# would need its own constraint files).

RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-noto-core fonts-noto-cjk fontconfig libgl1 \
    && fc-cache -f \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# The base image owns the CUDA and torch stack. Freeze it so no install below can replace it:
# a version conflict then fails the build instead of silently swapping the stack vLLM was
# built for. An empty freeze also fails the build.
RUN python3 -m pip freeze --all \
    | grep -E '^(torch|torchvision|torchaudio|triton|vllm|(nvidia|cuda)-[A-Za-z0-9_.-]+)==' \
    > /opt/base-constraints.txt \
    && test -s /opt/base-constraints.txt

# Exact Python pins are compiled with MinerU's compatibility limits and the Pillow override.
COPY deploy/constraints/accurate-gpu.txt /opt/accurate-gpu.txt
RUN python3 -m pip install --no-deps -c /opt/base-constraints.txt -r /opt/accurate-gpu.txt --break-system-packages

WORKDIR /app
COPY MinerU /opt/MinerU
RUN python3 -m pip install --no-deps -c /opt/base-constraints.txt -e '/opt/MinerU[torch]' --break-system-packages

COPY pyproject.toml README.md LICENSE ./
COPY src/ src/
RUN python3 -m pip install --no-deps -c /opt/base-constraints.txt -e '.[accurate,telemetry,telemetry-sdk]' --break-system-packages \
    && python3 -m pip cache purge

# The compiled set lifts gradio's Pillow cap to the fixed release; --no-deps keeps
# the resolver from reapplying that unused web UI's cap. Native GPU packages stay in the base.

COPY deploy/entrypoint-accurate.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Run unprivileged. The platform may force UID 1000 and set no HOME, so everything MinerU
# writes lives under MINERU_HOME, which that user owns. The models are baked in below, as
# that user, so they stay readable and writable markers work at run time.
ENV MINERU_HOME=/opt/mineru \
    HOME=/opt/mineru
RUN mkdir -p /opt/mineru && chown 1000:1000 /opt/mineru
USER 1000

# Align the prepared repositories and serving backends with MinerU's GPU
# deployment defaults. The model source switches to local in the entrypoint.
ENV WORKERS=2 \
    LOG_LEVEL=INFO \
    MINERU_MODEL_SMALL_BACKEND=torch \
    MINERU_MODEL_VLM_ENGINE=vllm \
    MINERU_DOWNLOAD_MODELS=standard

# The download goes through the same pinned path as the entrypoint, so the weights match
# src/two_tier_parser/accurate/model_revisions.json instead of the newest files.
RUN MINERU_MODEL_SOURCE=huggingface python3 -m two_tier_parser.accurate.prepare_models

EXPOSE 8005
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8005/health')"
ENTRYPOINT ["/entrypoint.sh"]
