# Fast Parser Service Dockerfile
# CPU-only PDF parsing with PyMuPDF4LLM. Build from the repository root:
#   docker build -f deploy/Dockerfile.fast -t fast-parser .

# Stage 1: turn uv.lock into pip constraints so the image installs exactly the locked
# versions. A dependency bump merged into uv.lock reaches the next build automatically.
FROM python:3.12-slim AS constraints
RUN pip install --no-cache-dir uv
WORKDIR /build
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-hashes --no-emit-project \
        --extra fast --extra telemetry --extra telemetry-sdk \
        -o constraints.txt

# Stage 2: runtime image
FROM python:3.12-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libffi-dev \
    libjpeg-dev \
    zlib1g-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=constraints /build/constraints.txt /tmp/constraints.txt
COPY pyproject.toml README.md ./
COPY src/ src/

# Install the package with API + SDK + OTLP exporter; traces are exported only when
# OTEL_EXPORTER_OTLP_ENDPOINT is set.
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -c /tmp/constraints.txt ".[fast,telemetry,telemetry-sdk]"

# Run unprivileged. HOME is writable so libraries that cache under it work with a
# read-only root filesystem.
ENV HOME=/tmp
ENV WORKERS=4
ENV LOG_LEVEL=INFO
USER 1000

# Expose port
EXPOSE 8004

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8004/health')"

# Run application (main.py follows industry standard naming convention)
CMD ["python", "-m", "uvicorn", "two_tier_parser.fast.main:app", "--host", "0.0.0.0", "--port", "8004"]
